# pyenv
#   For a library or app, you might want to share your .python-version.
#   For a business app, you might want to share it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used in a vitualenv, it may not be necessary.
#Pipfile.lock

# poetry
#   Poetry uses pyproject.toml to manage dependencies and lockfile.
#   However, in case of collaboration, if used in a vitualenv, it may not be necessary.
#poetry.lock

# pdm
#   Similar to Poetry and Pipenv, PDM uses pyproject.toml to manage dependencies and pdm.lock.
# .pdm.toml
.pdm-python
.pdm-build/

# pipxml
#   pdm-pep517 uses this directory to store build caches
.pdm-pep517/

# PEP 582; metadata and dependency directory (e.g. pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

