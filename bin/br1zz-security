#!/usr/bin/env python3
"""Br1zz Security launcher.

Resolves the package relative to this script so the tool runs from a git
checkout without needing to be installed.
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from br1zz_security.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
